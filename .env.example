# ---------------------------------------------------------------- ORCA server
ORCA_HOST=127.0.0.1
ORCA_PORT=4000
# Require "Authorization: Bearer <token>" on /api (recommended outside localhost)
# ORCA_API_TOKEN=

# ----------------------------------------------------------------------- LLM
# mock = deterministic heuristics, no network. anthropic = Claude via the official SDK.
ORCA_LLM_PROVIDER=mock
# ORCA_LLM_MODEL=claude-opus-5-5
# ORCA_LLM_EFFORT=medium
# Credentials for the anthropic provider are read by the SDK itself:
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------- Jira
# mock = fixtures/jira/issues.json. cloud = real Jira Cloud (REST v3).
JIRA_MODE=mock
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=SHOP
# JIRA_JQL=project = SHOP AND sprint in openSprints() ORDER BY updated DESC
# JIRA_AC_FIELD=customfield_10042   # custom field holding acceptance criteria (optional)
# JIRA_DEFECT_ISSUE_TYPE=Bug
JIRA_POLL_INTERVAL_MS=30000
# Start the QA workflow automatically when a ticket moves to JIRA_TRIGGER_STATUS
JIRA_AUTO_TRIGGER=false
JIRA_TRIGGER_STATUS=Ready for QA

# ------------------------------------------------------------- GitHub / CI
# With both set, code context is read from GitHub instead of ./demo-app
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
# CI_USE_GITHUB_ACTIONS=true

# --------------------------------------------------- Application under test
ORCA_TARGET_BASE_URL=http://127.0.0.1:4100
ORCA_START_DEMO_APP=true
# ORCA_CODE_DIR=demo-app

# ---------------------------------------------------------------- Playwright
PLAYWRIGHT_WORKERS=2
PLAYWRIGHT_TEST_TIMEOUT_MS=10000
PLAYWRIGHT_RUN_TIMEOUT_MS=180000

# ------------------------------------------------------------- Orchestrator
ORCA_MAX_CONCURRENT_RUNS=3
ORCA_AGENT_CONCURRENCY=2
ORCA_TASK_TIMEOUT_MS=240000
ORCA_TASK_RETRIES=1
# ORCA_MCP_CONFIG=orca.mcp.json
